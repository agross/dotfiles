# vim: set ft=zsh ts=2 sw=2 et:
# shellcheck disable=SC2168,SC2086

(($+commands[beet])) || return

[[ $1 == --status ]] || return

setopt glob
local music_files=(*.(mp3|flac|mpc|opus|m4a)(.NY1))
if ((#music_files == 0)); then
  return
fi

[[ $PWD == */_Singles* ]] && return

local current_dir album_info cover_info album cover embedded_cover

current_dir="$(printf '%s' "$PWD" | iconv --from-code UTF-8 --to-code UTF-8-MAC)"

album_info=("${(@f)$(beet info --include-keys=album_id,artpath \
                               --library \
                               --summarize \
                               path:${current_dir})}")

album_id=${album_info[1]#album_id: }
album="%B%F{blue}id:${album_id:-?}%f%b"

printf '💿 %s' $album

cover=$album_info[2]
if [[ -n $cover ]]; then
  if [[ $cover == *artpath:\ None ]]; then
    cover='%B%F{red}✘%f%b 🖼'
  else
    cover='%B%F{green}✔%f%b 🖼'
  fi

  printf ', %s' $cover
fi

if [[ ! -v PROMPT_BEET_NO_COVER && -n $album_id ]]; then
  cover_info=$(beet info --include-keys=art \
                         --summarize \
                         path:${current_dir})
  if [[ $cover_info == 'art: True' ]]; then
    embedded_cover='%B%F{green}✔%f%b 📄'
  else
    embedded_cover='%B%F{red}✘%f%b 📄'
  fi

  printf ', %s' $embedded_cover
fi
