# shellcheck shell=bash
# vim: set ft=sh ts=2 sw=2 et:

symlink "$topic/gitconfig"
symlink "$topic/gitconfig.training"
symlink "$topic/git-wtfrc"

if [[ "$OSTYPE" == darwin* ]]; then
  formula git
  formula git-lfs

  formula git-delta
  formula diffnav
  formula git-graph

  cask beyond-compare
  cask diffmerge
  cask kdiff3

  cask fork

  formula asciinema
fi

platform_specific=()
if [[ "$OSTYPE" == darwin* ]]; then
  platform_specific=("$topic/platform-specific/macos")
fi

platform_specific+=("$topic/platform-specific/_")

# Find platform-specific and generic configs with generics sorted last.
# Poor man's mapfile on macOS bash 3.2.
configs=()
while IFS= read -r -d '' config; do
  configs+=("$config")
done < <(find "${platform_specific[@]}" \
              -mindepth 1 \
              -maxdepth 1 \
              -type f \
              -name '*.config' \
              -print0 2> /dev/null)

processed=()

# https://stackoverflow.com/questions/7577052/
for config in "${configs[@]:+${configs[@]}}"; do
  name="$(basename "$config")"
  target="$HOME/.config/git/${name%%.*}.config"

  for p in "${processed[@]:+${processed[@]}}"; do
    if [[ "$p" == "$target" ]]; then
      success "$(printf "Skipped %b%s%b (already has been linked)" \
                        "$green" "$config" "$reset_color")"
      continue 2
    fi
  done

  symlink "$config" "$target"
  processed+=("$target")
done
